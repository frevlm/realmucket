{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Native debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mac-dev",
      "inherits": "dev",
      "displayName": "macOS debug build (AppleClang, matching Homebrew's gRPC)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "/usr/bin/clang++" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "mac-dev", "configurePreset": "mac-dev" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "mac-dev", "configurePreset": "mac-dev", "output": { "outputOnFailure": true } }
  ]
}
